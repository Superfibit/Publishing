# AI Book Publisher Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# AI Provider (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Amazon
AMAZON_ASSOCIATE_TAG=your_associate_tag
AMAZON_ACCESS_KEY=your_access_key
AMAZON_SECRET_KEY=your_secret_key
AMAZON_PARTNER_TAG=your_partner_tag

# Social Media - Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Social Media - Facebook/Instagram
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_TOKEN=your_page_access_token
INSTAGRAM_BUSINESS_ID=your_instagram_business_id

# Social Media - TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Your Author Name

# Google (for SEO & Analytics)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Approval Settings
APPROVAL_EMAIL=your_email@gmail.com
REQUIRE_APPROVAL_THRESHOLD=0
